# Copy to .env and fill in values. Never commit real credentials.
# `shopify app dev` can write Shopify keys into a local .env for you.

# From the Shopify Dev Dashboard (Client ID / Client secret).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS URL of this app (tunnel URL in development).
SHOPIFY_APP_URL=https://your-app-url.example

# Must match [access_scopes] in shopify.app.toml.
SCOPES=read_orders,write_orders

# Prisma datasource. Path is relative to the prisma/ directory.
DATABASE_URL=file:dev.sqlite

# Optional. Only for custom shop domains (for example Plus stores).
# SHOP_CUSTOM_DOMAIN=
