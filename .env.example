# Copy to .env:  cp .env.example .env
# Never commit real credentials.
#
# For local development you usually only need DATABASE_URL.
# `npm run dev` (`shopify app dev`) creates/links the Shopify app
# and writes the SHOPIFY_* values into .env for you.

# Client ID from Dev Dashboard → Apps → your app → Settings.
SHOPIFY_API_KEY=

# Client secret from the same page. Used for OAuth and webhook HMAC.
SHOPIFY_API_SECRET=

# Public HTTPS URL. In `shopify app dev` this is the CLI tunnel URL.
SHOPIFY_APP_URL=https://your-app-url.example

# Must match [access_scopes] in shopify.app.toml.
SCOPES=read_orders,write_orders

# Prisma datasource. Path is relative to the prisma/ directory.
DATABASE_URL=file:dev.sqlite

# Optional. Only for custom shop domains (for example Plus stores).
# SHOP_CUSTOM_DOMAIN=
